@page
@model TempooHub.AuthServer.Pages.Admin.RolesModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 p-8">
    <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold">Gestión de Roles</h2>
            <a href="/Admin/Users" class="text-sm text-slate-300 hover:text-white">Volver a Usuarios</a>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-6 rounded-xl mb-6">
            <form method="post" asp-page-handler="Create" class="flex gap-4">
                <input asp-for="NewRoleName" placeholder="Nombre del rol" class="bg-slate-800 border border-slate-700 p-2 rounded flex-1">
                <button class="bg-blue-600 px-6 py-2 rounded font-bold">Crear Rol</button>
            </form>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-2xl">
            <table class="w-full text-left">
                <thead class="bg-slate-800 text-slate-400">
                    <tr>
                        <th class="p-4">Rol</th>
                        <th class="p-4">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                    @foreach (var role in Model.Roles)
                    {
                        <tr class="hover:bg-slate-800/30">
                            <td class="p-4 font-medium">@role.Name</td>
                            <td class="p-4">
                                <form method="post" asp-page-handler="Delete" asp-route-id="@role.Id" onsubmit="return confirm('¿Eliminar rol?')">
                                    <button class="text-red-500 text-sm hover:text-red-400">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
