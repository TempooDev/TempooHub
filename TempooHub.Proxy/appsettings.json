{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/auth"
          },
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/v1/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://tempoohub-auth"
          }
        }
      },
      "api-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://tempoohub-api"
          }
        }
      }
    }
  }
}