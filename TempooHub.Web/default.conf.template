server {
    # Nginx sustituirá ${PORT} por el valor real al arrancar
    listen        ${PORT};
    listen  [::]:${PORT};
    server_name  localhost;

    access_log  /var/log/nginx/server.access.log  main;

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    # Proxy inverso hacia tu backend
    location /api/ {
        # IMPORTANTE: En Docker interno usamos HTTP, no HTTPS (ahorras certificados internos)
        # Usamos el nombre del servicio definido en docker-compose
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}; 
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection keep-alive;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Si tu backend NO espera el prefijo /api, mantén el rewrite:
        rewrite ^/api(/.*)$ $1 break;
    }
}